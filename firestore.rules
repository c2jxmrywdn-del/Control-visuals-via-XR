rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 0: Global Safety Net (Default-Deny Catch-All)
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Hardened Global Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isVerifiedOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function hasActiveParentUser(userId) {
      return exists(/databases/$(database)/documents/users/$(userId)) &&
        get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;
    }

    function hasParentUserNowOrAfter(userId) {
      return (exists(/databases/$(database)/documents/users/$(userId)) &&
        get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid) ||
        (existsAfter(/databases/$(database)/documents/users/$(userId)) &&
        getAfter(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid);
    }

    // Validation Blueprint 1: UserPublicProfile (/users/{userId})
    function isValidUserPublicProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'preferredSpeciesId', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'displayName', 'preferredSpeciesId', 'createdAt', 'updatedAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.uid == request.auth.uid && data.uid == userId &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
        data.preferredSpeciesId is string && data.preferredSpeciesId.size() >= 1 && data.preferredSpeciesId.size() <= 40 && data.preferredSpeciesId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        data.updatedAt == request.time;
    }

    // Validation Blueprint 2: UserPrivateInfo (/users/{userId}/private/{infoId})
    function isValidUserPrivateInfo(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'createdAt', 'updatedAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.uid == request.auth.uid && data.uid == userId &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        data.email == request.auth.token.email &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        data.updatedAt == request.time;
    }

    // Validation Blueprint 3: BotanicalPreset (/users/{userId}/presets/{presetId})
    function isValidBotanicalPreset(data, userId, presetId) {
      return data.keys().hasAll([
          'presetId', 'ownerId', 'title', 'speciesId', 'environmentId',
          'bloomPct', 'pitchRad', 'yawRad', 'rollRad', 'gaussianSplatMode',
          'sensitivityPct', 'tags', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'presetId', 'ownerId', 'title', 'speciesId', 'environmentId',
          'bloomPct', 'pitchRad', 'yawRad', 'rollRad', 'gaussianSplatMode',
          'sensitivityPct', 'tags', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.presetId is string && data.presetId.size() >= 1 && data.presetId.size() <= 128 && data.presetId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.presetId == presetId &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId == request.auth.uid && data.ownerId == userId &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 64 &&
        data.speciesId is string && data.speciesId.size() >= 1 && data.speciesId.size() <= 40 && data.speciesId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.environmentId is string && data.environmentId.size() >= 1 && data.environmentId.size() <= 40 && data.environmentId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.bloomPct is number && data.bloomPct >= 0 && data.bloomPct <= 100 &&
        data.pitchRad is number && data.pitchRad >= -1.6 && data.pitchRad <= 1.6 &&
        data.yawRad is number && data.yawRad >= -6.5 && data.yawRad <= 6.5 &&
        data.rollRad is number && data.rollRad >= -1.6 && data.rollRad <= 1.6 &&
        data.gaussianSplatMode is string && data.gaussianSplatMode.size() >= 8 && data.gaussianSplatMode.size() <= 16 &&
        (data.gaussianSplatMode == 'hybrid-3dgs' || data.gaussianSplatMode == 'pure-3dgs' || data.gaussianSplatMode == 'pbr-mesh') &&
        data.sensitivityPct is number && data.sensitivityPct >= 20 && data.sensitivityPct <= 100 &&
        data.tags is list && data.tags.size() <= 5 &&
        (data.tags.size() == 0 || (data.tags[0] is string && data.tags[0].size() >= 1 && data.tags[0].size() <= 24)) &&
        data.status is string && data.status.size() >= 6 && data.status.size() <= 12 &&
        (data.status == 'active' || data.status == 'archived') &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        data.updatedAt == request.time;
    }

    // Collection 1: Public User Profile (/users/{userId})
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId) && existing().uid == request.auth.uid;
      allow list: if false;
      allow create: if isVerifiedOwner(userId) &&
        isValidId(userId) &&
        isValidUserPublicProfile(incoming(), userId) &&
        incoming().createdAt == request.time;
      allow update: if isVerifiedOwner(userId) &&
        isValidId(userId) &&
        isValidUserPublicProfile(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'preferredSpeciesId', 'updatedAt']);
      allow delete: if false;

      // Collection 2: Isolated Private PII Subcollection (/users/{userId}/private/{infoId})
      match /private/{infoId} {
        allow get: if isVerifiedOwner(userId) &&
          isValidId(userId) &&
          isValidId(infoId) &&
          existing().uid == request.auth.uid &&
          hasActiveParentUser(userId);
        allow list: if false;
        allow create: if isVerifiedOwner(userId) &&
          isValidId(userId) &&
          isValidId(infoId) &&
          infoId == 'profile' &&
          isValidUserPrivateInfo(incoming(), userId) &&
          incoming().createdAt == request.time &&
          hasParentUserNowOrAfter(userId);
        allow update: if isVerifiedOwner(userId) &&
          isValidId(userId) &&
          isValidId(infoId) &&
          infoId == 'profile' &&
          isValidUserPrivateInfo(incoming(), userId) &&
          incoming().uid == existing().uid &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updatedAt']) &&
          hasActiveParentUser(userId);
        allow delete: if false;
      }

      // Collection 3: Botanical Presets Subcollection (/users/{userId}/presets/{presetId})
      match /presets/{presetId} {
        allow get: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(presetId) &&
          existing().ownerId == request.auth.uid &&
          hasActiveParentUser(userId);

        // Pillar 8: Secure List Queries (No get()/exists() inside list; evaluates resource.data)
        allow list: if isOwner(userId) &&
          existing().ownerId == request.auth.uid;

        allow create: if isVerifiedOwner(userId) &&
          isValidId(userId) &&
          isValidId(presetId) &&
          isValidBotanicalPreset(incoming(), userId, presetId) &&
          incoming().status == 'active' &&
          incoming().createdAt == request.time &&
          hasParentUserNowOrAfter(userId);

        // Pillar 4, 5 & 6: Action-Based Update + Terminal State Locking ('archived' is terminal)
        allow update: if isVerifiedOwner(userId) &&
          isValidId(userId) &&
          isValidId(presetId) &&
          isValidBotanicalPreset(incoming(), userId, presetId) &&
          existing().status != 'archived' &&
          incoming().presetId == existing().presetId &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt && (
            // Action 1: Update Floral Posture & Rendering Parameters
            (incoming().status == 'active' &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'title', 'speciesId', 'environmentId', 'bloomPct',
                'pitchRad', 'yawRad', 'rollRad', 'gaussianSplatMode',
                'sensitivityPct', 'tags', 'updatedAt'
              ])) ||
            // Action 2: Archive Preset (Terminal Transition)
            (existing().status == 'active' &&
              incoming().status == 'archived' &&
              incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
          ) &&
          hasActiveParentUser(userId);

        allow delete: if isVerifiedOwner(userId) &&
          isValidId(userId) &&
          isValidId(presetId) &&
          existing().ownerId == request.auth.uid &&
          hasActiveParentUser(userId);
      }
    }
  }
}
